{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@hazejs/core": [
        "../packages/core/src/index.ts"
      ],
      "~/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "vite/client",
      "@hazejs/vite/client"
    ]
  },
  "include": [
