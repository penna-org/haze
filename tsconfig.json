{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@hazejs/core",
    "paths": {
      "@hazejs/core": [
        "./packages/core/src/index.ts"
      ],
      "@hazejs/core/client": [
        "./packages/core/src/client.ts"
      ],
      "@hazejs/core/echo": [
        "./packages/core/src/broadcast/echo.ts"
      ],
      "@hazejs/core/jsx-runtime": [
        "./packages/core/src/jsx-runtime.ts"
      ],
      "@hazejs/core/jsx-dev-runtime": [
        "./packages/core/src/jsx-dev-runtime.ts"
      ],
      "~/*": [
        "./playground/*"
      ],
      "@hazejs/vite": [
        "./packages/vite/src/index.ts"
      ],
      "@hazejs/testing": [
        "./packages/testing/src/index.ts"
      ],
      "@hazejs/socket.io": [
        "./packages/socketio/src/index.ts"
      ],
      "@hazejs/ai": [
        "./packages/ai/src/index.ts"
      ],
      "@hazejs/graphql": [
        "./packages/graphql/src/index.ts"
      ],
      "@hazejs/microservices": [
        "./packages/microservices/src/index.ts"
      ],
      "@hazejs/search": [
        "./packages/search/src/index.ts"
      ],
      "@hazejs/oauth": [
        "./packages/oauth/src/index.ts"
      ],
      "@hazejs/devtools": [
        "./packages/devtools/src/index.ts"
      ],
      "@hazejs/auto-import": [
        "./packages/auto-import/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/vite/client.d.ts",
    "*.ts"
  ],
  "exclude": [
    "packages/*/test/fixtures",
    "packages/*/test/.tmp",
    "packages/create/templates"
  ]
}
