{
  "name": "@think-h3/testing",
  "type": "module",
  "version": "0.0.0",
  "description": "think-h3 testing helpers for Vitest",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@think-h3/core": "workspace:^",
    "@think-h3/vite": "workspace:^",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@think-h3/core": "workspace:*",
    "@think-h3/vite": "workspace:*",
    "vitest": "catalog:"
  }
}
