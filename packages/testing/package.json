{
  "name": "@hazejs/testing",
  "type": "module",
  "version": "0.4.0",
  "description": "Vitest helpers for hazejs: test app, HTTP client, actingAs and fakes",
  "license": "MIT",
  "homepage": "https://github.com/penna-org/haze/tree/main/packages/testing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penna-org/haze.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/penna-org/haze/issues"
  },
  "keywords": [
    "hazejs",
    "haze",
    "nodejs",
    "typescript",
    "testing",
    "vitest"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@hazejs/core": "workspace:^",
    "@hazejs/vite": "workspace:^",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@hazejs/core": "workspace:*",
    "@hazejs/vite": "workspace:*",
    "vitest": "catalog:"
  }
}
