{
  "name": "create-hazejs",
  "type": "module",
  "version": "0.2.0",
  "description": "Create a hazejs project (API, Vue or React full-stack)",
  "license": "MIT",
  "homepage": "https://github.com/penna-org/haze/tree/main/packages/create#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penna-org/haze.git",
    "directory": "packages/create"
  },
