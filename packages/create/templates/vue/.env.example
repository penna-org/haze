# 环境变量示例（进入 git）：克隆项目后 cp .env.example .env，再运行 npx haze key:generate
# .env 含密钥，已在 .gitignore 中忽略
# 后端读取（process.env）
APP_NAME={{name}}
DATABASE_URL=file:./data/app.db

# 前端读取（import.meta.env，需 VITE_ 前缀）
VITE_APP_TITLE={{name}}
# 应用密钥（签名 Cookie、加密 Session、JWT）：复制为 .env 后运行 npx haze key:generate 生成
APP_KEY=
# GitHub 登录（server/config/oauth.ts），留空则关闭
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
