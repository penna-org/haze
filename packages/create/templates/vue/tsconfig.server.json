{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2023",
    "jsx": "react-jsx",
    "jsxImportSource": "@hazejs/core",
    "lib": [
      "ES2023"
    ],
    "moduleDetection": "force",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "~/*": [
        "./server/*"
      ]
    },
    "types": [
      "node",
      "vite/client",
      "@hazejs/vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "server/**/*.ts",
    "server/**/*.tsx",
    "tests/**/*.ts",
    "*.config.ts",
    ".haze/types/**/*.d.ts"
  ]
}
