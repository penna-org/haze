{
  "name": "@hazejs/search",
  "type": "module",
  "version": "1.0.0",
  "description": "Full-text search for hazejs models: database full-text (MySQL FULLTEXT, PostgreSQL tsvector, SQLite FTS5, LIKE), Meilisearch, Typesense and Elasticsearch / OpenSearch over fetch, with model index syncing",
  "license": "MIT",
  "homepage": "https://github.com/penna-org/haze/tree/main/packages/search#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penna-org/haze.git",
    "directory": "packages/search"
  },
  "bugs": {
    "url": "https://github.com/penna-org/haze/issues"
  },
  "keywords": [
    "hazejs",
    "haze",
    "nodejs",
    "typescript",
    "search",
    "full-text",
    "meilisearch",
    "typesense",
    "elasticsearch",
    "opensearch",
    "fts5"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@hazejs/core": "workspace:^",
    "@hazejs/orm": "workspace:^",
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@hazejs/core": "workspace:*",
    "@hazejs/orm": "workspace:*",
    "@libsql/client": "catalog:",
    "drizzle-orm": "catalog:",
    "mysql2": "catalog:",
    "postgres": "catalog:"
  }
}
