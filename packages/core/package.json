{
  "name": "@think-h3/core",
  "type": "module",
  "version": "0.0.0",
  "description": "think-h3 runtime core: container, routing, middleware, exceptions on top of h3",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cloudflare": {
      "types": "./dist/adapters/cloudflare.d.mts",
      "default": "./dist/adapters/cloudflare.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/client-sesv2": "^3.1158.0",
    "@aws-sdk/lib-storage": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@upstash/redis": "^1.40.0",
    "bullmq": "^6.5.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "consola": "catalog:",
    "croner": "catalog:",
    "crossws": "catalog:",
    "h3": "catalog:",
    "jose": "catalog:",
    "srvx": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sesv2": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@upstash/redis": "catalog:",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "miniflare": "catalog:",
    "nodemailer": "catalog:",
    "valibot": "catalog:"
  }
}
