{
  "name": "@hazejs/core",
  "type": "module",
  "version": "0.4.0",
  "description": "The hazejs runtime: IoC container, routing, middleware, auth, cache, queues, events, WebSocket, storage and mail on top of h3",
  "license": "MIT",
  "homepage": "https://github.com/penna-org/haze/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penna-org/haze.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/penna-org/haze/issues"
  },
  "keywords": [
    "hazejs",
    "haze",
    "nodejs",
    "typescript",
    "framework",
    "backend",
    "server",
    "h3",
    "ioc",
    "routing",
    "middleware",
    "auth",
    "queue",
    "websocket"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cloudflare": {
      "types": "./dist/adapters/cloudflare.d.mts",
      "default": "./dist/adapters/cloudflare.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./echo": {
      "types": "./dist/broadcast/echo.d.mts",
      "default": "./dist/broadcast/echo.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.mts",
      "default": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.mts",
      "default": "./dist/jsx-dev-runtime.mjs"
    },
    "./auto-imports": {
      "types": "./dist/auto-imports.d.mts",
      "default": "./dist/auto-imports.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/client-sesv2": "^3.1158.0",
    "@aws-sdk/lib-storage": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@opentelemetry/api": "^1.9.0",
    "@simplewebauthn/server": "^13.0.0 || ^14.0.0",
    "@upstash/redis": "^1.40.0",
    "@valibot/to-json-schema": "^1.0.0",
    "bullmq": "^6.5.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@simplewebauthn/server": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    },
    "@valibot/to-json-schema": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "consola": "catalog:",
    "croner": "catalog:",
    "crossws": "catalog:",
    "h3": "catalog:",
    "jose": "catalog:",
    "srvx": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sesv2": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@upstash/redis": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "miniflare": "catalog:",
    "nodemailer": "catalog:",
    "valibot": "catalog:",
    "zod": "catalog:"
  }
}
