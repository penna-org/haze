{
  "name": "@think-h3/core",
  "type": "module",
  "version": "0.0.0",
  "description": "think-h3 runtime core: container, routing, middleware, exceptions on top of h3",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@upstash/redis": "^1.40.0",
    "ioredis": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "consola": "catalog:",
    "h3": "catalog:",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@upstash/redis": "catalog:",
    "ioredis": "catalog:",
    "miniflare": "catalog:",
    "valibot": "catalog:"
  }
}
