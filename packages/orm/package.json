{
  "name": "@think-h3/orm",
  "type": "module",
  "version": "0.0.0",
  "description": "think-h3 ORM: ThinkPHP-style Db query builder and Model on top of drizzle (MySQL / PostgreSQL / SQLite)",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "@libsql/client": "^0.18.0",
    "@think-h3/core": "workspace:^",
    "drizzle-orm": "^0.45.0",
    "mysql2": "^3.0.0",
    "postgres": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": { "optional": true },
    "@libsql/client": { "optional": true },
    "mysql2": { "optional": true },
    "postgres": { "optional": true }
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@libsql/client": "catalog:",
    "@think-h3/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "mysql2": "catalog:",
    "postgres": "catalog:"
  }
}
