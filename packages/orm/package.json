{
  "name": "@hazejs/orm",
  "type": "module",
  "version": "0.2.0",
  "description": "Models, query builder and migrations for hazejs on top of drizzle (MySQL, PostgreSQL, SQLite, Turso, D1, MongoDB)",
  "license": "MIT",
  "homepage": "https://github.com/penna-org/haze/tree/main/packages/orm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penna-org/haze.git",
    "directory": "packages/orm"
  },
  "bugs": {
    "url": "https://github.com/penna-org/haze/issues"
  },
  "keywords": [
    "hazejs",
    "haze",
    "nodejs",
    "typescript",
    "orm",
    "drizzle",
    "mysql",
    "postgresql",
    "sqlite",
    "turso",
    "d1",
    "mongodb",
    "active-record"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./columns": {
      "types": "./dist/columns.d.mts",
      "default": "./dist/columns.mjs"
    },
    "./mongo": {
      "types": "./dist/mongo/index.d.mts",
      "default": "./dist/mongo/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "@faker-js/faker": "^10.0.0",
    "@hazejs/core": "workspace:^",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.0",
    "mongodb": "^7.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "postgres": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@faker-js/faker": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@faker-js/faker": "catalog:",
    "@hazejs/core": "workspace:*",
    "@libsql/client": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "miniflare": "catalog:",
    "mongodb": "catalog:",
    "mongodb-memory-server-core": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:",
    "postgres": "catalog:"
  }
}
