{
  "name": "@think-h3/vite",
  "type": "module",
  "version": "0.0.0",
  "description": "think-h3 Vite plugin: virtual app manifest, hot-swapping dev server and production server build",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "client.d.ts",
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@think-h3/core": "workspace:^",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "consola": "catalog:",
    "srvx": "catalog:"
  },
  "devDependencies": {
    "@think-h3/core": "workspace:*",
    "vite": "catalog:"
  }
}
