{
  "name": "@hazejs/vite",
  "type": "module",
  "version": "0.4.0",
  "description": "Vite plugin for hazejs: hot-reloading backend, full-stack dev server and deployment presets",
  "license": "MIT",
  "homepage": "https://github.com/penna-org/haze/tree/main/packages/vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penna-org/haze.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/penna-org/haze/issues"
  },
  "keywords": [
    "hazejs",
    "haze",
    "nodejs",
    "typescript",
    "vite",
    "vite-plugin",
    "fullstack",
    "ssr",
    "deploy",
    "cloudflare",
    "vercel",
    "netlify",
    "aws-lambda"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "client.d.ts",
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@hazejs/core": "workspace:^",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "consola": "catalog:",
    "nf3": "catalog:",
    "srvx": "catalog:"
  },
  "devDependencies": {
    "@hazejs/auto-import": "workspace:*",
    "@hazejs/core": "workspace:*",
    "deno": "catalog:",
    "miniflare": "catalog:",
    "vite": "catalog:"
  }
}
