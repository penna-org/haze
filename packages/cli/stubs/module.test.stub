import { useTestApp } from '@hazejs/testing'
import { describe, expect, it } from 'vitest'

const t = useTestApp()

describe('{{kebabName}} module', () => {
  it('serves its routes under the module prefix', async () => {
    const res = await t.get('/api/{{kebabName}}')
    expect(res.status).toBe(200)
    expect(res.body.data).toEqual({ module: '{{kebabName}}', perPage: 20 })
  })
})
