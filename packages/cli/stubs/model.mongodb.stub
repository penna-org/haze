export interface {{className}}Doc {
  name: string
  createdAt?: Date
  updatedAt?: Date
  deletedAt?: Date | null
}

/**
 * {{name}} 模型（集合 {{tableName}}），API 与 SQL 模型一致：
 * {{className}}.findOrFail(id)、{{className}}.where('name', 'Ada').paginate(1, 20)、{{className}}.create(data)
 */
export class {{className}} extends MongoModel.define<{{className}}Doc>('{{tableName}}') {
  static override softDelete = {{softDelete}}
}
