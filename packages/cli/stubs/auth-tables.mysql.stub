import { boolean, index, int, json, mysqlTable, primaryKey, serial, timestamp, varchar } from 'drizzle-orm/mysql-core'

// 认证扩展的表结构：个人访问令牌、找回密码、两步验证、通行密钥（WebAuthn）
// 此文件只依赖 drizzle-orm，不要使用 ~ 别名（drizzle-kit 需要直接读取）；不需要的表可以删除
// 生成迁移：haze db:generate && haze db:migrate
// JS 属性名由 @hazejs/orm 的 database*Store() 读取，请勿修改（列名可以改）

export const personalAccessTokens = mysqlTable('personal_access_tokens', {
  id: serial('id').primaryKey(),
  tokenableType: varchar('tokenable_type', { length: 191 }).notNull(),
  tokenableId: varchar('tokenable_id', { length: 191 }).notNull(),
  name: varchar('name', { length: 255 }).notNull(),
  // 明文令牌的 SHA-256 摘要
  token: varchar('token', { length: 64 }).notNull().unique(),
  abilities: json('abilities').$type<string[]>().notNull(),
  lastUsedAt: timestamp('last_used_at', { fsp: 3 }),
  expiresAt: timestamp('expires_at', { fsp: 3 }),
  createdAt: timestamp('created_at', { fsp: 3 }).notNull(),
}, table => [
  index('personal_access_tokens_tokenable_index').on(table.tokenableType, table.tokenableId),
])

export const passwordResetTokens = mysqlTable('password_reset_tokens', {
  email: varchar('email', { length: 191 }).primaryKey(),
  // 重置令牌的 SHA-256 摘要
  token: varchar('token', { length: 64 }).notNull(),
  createdAt: timestamp('created_at', { fsp: 3 }).notNull(),
})

export const twoFactorSecrets = mysqlTable('two_factor_secrets', {
  userType: varchar('user_type', { length: 191 }).notNull(),
  userId: varchar('user_id', { length: 191 }).notNull(),
  // TOTP 密钥（APP_KEY 加密）
  secret: varchar('secret', { length: 512 }).notNull(),
  // 恢复码的 SHA-256 摘要
  recoveryCodes: json('recovery_codes').$type<string[]>().notNull(),
  confirmedAt: timestamp('confirmed_at', { fsp: 3 }),
  lastUsedStep: int('last_used_step'),
  createdAt: timestamp('created_at', { fsp: 3 }).notNull(),
}, table => [
  primaryKey({ columns: [table.userType, table.userId] }),
])

export const webauthnCredentials = mysqlTable('webauthn_credentials', {
  // 凭据 ID（base64url）
  id: varchar('id', { length: 512 }).primaryKey(),
  userType: varchar('user_type', { length: 191 }).notNull(),
  userId: varchar('user_id', { length: 191 }).notNull(),
  name: varchar('name', { length: 255 }),
  publicKey: varchar('public_key', { length: 2048 }).notNull(),
  counter: int('counter').notNull().default(0),
  transports: json('transports').$type<string[]>().notNull(),
  deviceType: varchar('device_type', { length: 32 }).notNull(),
  backedUp: boolean('backed_up').notNull().default(false),
  aaguid: varchar('aaguid', { length: 64 }),
  createdAt: timestamp('created_at', { fsp: 3 }).notNull(),
  lastUsedAt: timestamp('last_used_at', { fsp: 3 }),
}, table => [
  index('webauthn_credentials_user_index').on(table.userType, table.userId),
])
