import { index, integer, sqliteTable, text } from 'drizzle-orm/sqlite-core'

// 通知表（通知的 database 渠道）：此文件只依赖 drizzle-orm，不要使用 ~ 别名（drizzle-kit 需要直接读取）
// 生成迁移：haze db:generate && haze db:migrate
export const notifications = sqliteTable('notifications', {
  id: text('id').primaryKey(),
  type: text('type').notNull(),
  notifiableType: text('notifiable_type').notNull(),
  notifiableId: text('notifiable_id').notNull(),
  data: text('data', { mode: 'json' }).notNull(),
  readAt: integer('read_at', { mode: 'timestamp_ms' }),
  createdAt: integer('created_at', { mode: 'timestamp_ms' }).notNull(),
}, table => [
  index('notifications_notifiable_index').on(table.notifiableType, table.notifiableId),
])
