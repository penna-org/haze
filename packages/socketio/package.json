{
  "name": "@hazejs/socket.io",
  "type": "module",
  "version": "0.1.0",
  "description": "Socket.IO server integration for hazejs (namespaces, guard auth, Redis adapter, Node and Bun)",
  "license": "MIT",
  "homepage": "https://github.com/penna-org/haze/tree/main/packages/socketio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penna-org/haze.git",
    "directory": "packages/socketio"
  },
  "bugs": {
    "url": "https://github.com/penna-org/haze/issues"
  },
  "keywords": [
    "hazejs",
    "haze",
    "nodejs",
    "typescript",
    "socket.io",
    "websocket",
    "realtime"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@hazejs/core": "workspace:^",
    "@socket.io/bun-engine": "^0.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^6.0.0",
    "socket.io": "^4.8.0"
  },
  "peerDependenciesMeta": {
    "@socket.io/bun-engine": {
      "optional": true
    },
    "@socket.io/redis-adapter": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hazejs/core": "workspace:*",
    "@hazejs/vite": "workspace:*",
    "@socket.io/bun-engine": "catalog:",
    "@socket.io/redis-adapter": "catalog:",
    "ioredis": "catalog:",
    "socket.io": "catalog:",
    "socket.io-client": "catalog:"
  }
}
