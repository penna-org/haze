{
  "name": "@hazejs/devtools",
  "type": "module",
  "version": "0.2.0",
  "description": "Devtools for hazejs on top of devframe: app overview, module and route inspector, dev dashboard and terminals in one hub",
  "license": "MIT",
  "homepage": "https://github.com/penna-org/haze/tree/main/packages/devtools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penna-org/haze.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/penna-org/haze/issues"
  },
  "keywords": [
    "hazejs",
    "haze",
    "devtools",
    "devframe",
    "inspector"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@hazejs/core": "workspace:^"
  },
  "dependencies": {
    "@devframes/hub": "catalog:",
    "@devframes/hub-ui": "catalog:",
    "@devframes/json-render": "catalog:",
    "@devframes/json-render-ui": "catalog:",
    "@devframes/plugin-terminals": "catalog:",
    "@devframes/plugin-terminals--assets": "catalog:",
    "devframe": "catalog:"
  },
  "devDependencies": {
    "@hazejs/core": "workspace:*",
    "@hazejs/vite": "workspace:*"
  }
}
